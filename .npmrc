# Every dependency is pinned to an exact version, and installs must not drift.
#
# `save-exact` stops `npm install <pkg>` from writing a `^` range back into
# package.json. A caret is an instruction to take whatever the registry offers
# at install time, which is precisely the window a compromised release needs:
# the npm worm campaigns of the last year (Shai-Hulud and its successors)
# propagate by publishing a malicious patch version of an already-trusted
# package, so a caret range adopts it and a pinned version does not.
#
# Pinning is not protection on its own — it buys the delay in which an advisory
# can be published and read. Upgrades are therefore deliberate: change the
# version here, read what changed, commit the lockfile.
save-exact=true

# Never install from a lockfile-less resolution in CI or a fresh clone; `npm ci`
# is the command that honours the lockfile exactly. This only sets the default
# audit level for `npm install` output so a new advisory is visible rather than
# silent.
audit-level=moderate

# Deliberately NOT set: ignore-scripts. It is the obvious hardening lever and it
# would break this project — esbuild, sharp and workerd all fetch or build a
# platform binary in a postinstall script, and with scripts disabled they
# install and then fail at runtime. The lockfile's integrity hashes are what
# actually guard those downloads.
