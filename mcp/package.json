{
  "name": "enchiridion-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Enchiridion Great Books curriculum — exposes the corpus, its structure, and the reading program so an AI model can facilitate a student's reading, anchored to the actual texts.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "enchiridion-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "verify-toc": "node scripts/verify-toc.mjs",
    "check-links": "node scripts/check-links.mjs",
    "verify-resolution": "node scripts/verify-resolution.mjs"
  },
  "dependencies": {
    "@hono/mcp": "0.3.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "hono": "4.13.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260804.1",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "wrangler": "4.119.0"
  }
}
